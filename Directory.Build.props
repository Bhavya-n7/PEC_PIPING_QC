<Project>
  <!-- One version for the whole product. Change it here (and add a line to CHANGELOG.md) for every release. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>Petrocon Engineers and Consultants</Company>
    <Copyright>Petrocon Engineers and Consultants</Copyright>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
