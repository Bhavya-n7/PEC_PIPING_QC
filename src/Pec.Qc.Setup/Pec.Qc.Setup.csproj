<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PecQcSetup</AssemblyName>
    <RootNamespace>Pec.Qc.Setup</RootNamespace>
    <Product>PEC QC Assistant Setup</Product>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pec.Qc.Core\Pec.Qc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\logo.png" Link="logo.png" />
    <Resource Include="..\..\assets\logo-white.png" Link="logo-white.png" />
    <Page Include="..\Pec.Qc.Desktop\Theme.xaml" Link="Theme.xaml" />
    <Resource Include="..\..\assets\app.ico" Link="app.ico" />
  </ItemGroup>

</Project>
