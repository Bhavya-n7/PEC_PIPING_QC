<Window x:Class="Pec.Qc.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEC QC Assistant Setup" Icon="app.ico" Width="760" Height="820" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header band -->
        <Border Background="{StaticResource AccentDark}" Padding="32,24">
            <DockPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="logo-white.png" Height="84" HorizontalAlignment="Center" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="Heading" Text="PEC QC Assistant" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="Intro" Foreground="#D6DEFF" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13" TextAlignment="Center" MaxWidth="720"
                               Text="Helps the QC team check piping isometrics, P&amp;IDs and GA drawings against the Navisworks model and the project inputs. QC is read-only: it never changes a model or a drawing. Installs for your Windows user (no administrator rights) and asks before it changes anything."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,16">
                <!-- readiness checks -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="READINESS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="Checks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6">
                                        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="{StaticResource AppBg}" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Mark}" Foreground="{Binding Color}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="OptionsPanel">
                    <!-- where things go -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="INSTALL LOCATION" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TargetBox" IsReadOnly="True" Style="{StaticResource Field}" Margin="0,0,0,16"/>

                            <TextBlock Text="Shared office folder" FontWeight="SemiBold"/>
                            <TextBlock Text="Skills, lessons, requirements, projects, models, reports, the user list, custom tools and updates for everyone. Leave empty to keep everything on this PC; you can set it later in Settings." Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6"/>
                            <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="BrowseShared_Click"/><TextBox x:Name="SharedBox" Style="{StaticResource Field}"/></DockPanel>

                            <Expander Header="Advanced: use separate folders for skills, learning and documents" Foreground="{StaticResource InkMuted}">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Skills" Margin="0,0,0,3"/>
                                    <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0" Click="BrowseSkills_Click"/><TextBox x:Name="SkillsBox" Style="{StaticResource Field}"/></DockPanel>
                                    <TextBlock Text="Learning (lessons, decisions, client rules)" Margin="0,0,0,3"/>
                                    <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0" Click="BrowseLearning_Click"/><TextBox x:Name="LearningBox" Style="{StaticResource Field}"/></DockPanel>
                                    <TextBlock Text="Documents (client procedures, standards)" Margin="0,0,0,3"/>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0" Click="BrowseDocs_Click"/><TextBox x:Name="DocsBox" Style="{StaticResource Field}"/></DockPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- options -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="WHAT TO SET UP" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="OptInstallClaude" Content="Install Claude Code if it is not on this PC (official installer, needs internet)" IsChecked="True" Margin="0,5"/>
                            <CheckBox x:Name="OptCode" Content="Register the QC tools with Claude Code" IsChecked="True" Margin="0,5"/>
                            <CheckBox x:Name="OptDesktop" Content="Register them with Claude Desktop (your config file is backed up first)" IsChecked="True" Margin="0,5"/>
                            <CheckBox x:Name="OptSkills" Content="Copy the QC skills for Claude Code (a skill of yours with the same name is never replaced)" IsChecked="True" Margin="0,5"/>
                            <CheckBox x:Name="OptShortcut" Content="Add a Start-menu shortcut" IsChecked="True" Margin="0,5"/>
                        </StackPanel>
                    </Border>
                    <!-- MCP servers of other products -->
                    <Border x:Name="AddonsCard" Style="{StaticResource Card}" Margin="0,0,0,18" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="MCP SERVERS FOR YOUR AUTODESK PROGRAMS" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                            <TextBlock Text="Lets Claude work with AutoCAD, Plant 3D, Civil 3D, Navisworks and Revit while you have them open. Setup installs each ticked one itself after the QC tools: it downloads the server from its publisher, checks it, installs the plug-in, tests the server and connects it to Claude. Nothing to type and no console window. Close the Autodesk program first. A program that is not on this PC cannot be ticked; you can install any of them later from the assistant: Settings, MCP servers."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                            <StackPanel x:Name="AddonsPanel"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- progress log -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="PROGRESS" Style="{StaticResource Eyebrow}" Margin="18,14,18,6"/>
                        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 BorderThickness="0" Background="Transparent" MinHeight="110" MaxHeight="220" Padding="18,0,18,14"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Close" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Close_Click"/>
                <Button x:Name="ActionButton" Content="Install" Style="{StaticResource PrimaryButton}" Padding="34,10" Click="Action_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
