<Window x:Class="Pec.Qc.Desktop.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve this action?" Icon="app.ico" Width="720" Height="540" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,20">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="14" Background="{StaticResource WarnSoft}" Margin="0,0,16,0">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Approve this action?" Style="{StaticResource H2}" FontSize="20"/>
                    <TextBlock Text="Claude wants to save something for everyone (a skill, lesson, requirement pack, tool or report). Nothing happens unless you approve." Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="26,20,26,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="WHAT WILL HAPPEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="DETAILS" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
            </StackPanel>
            <TextBox x:Name="DetailText" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{StaticResource Field}" Padding="6"/>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Don't allow" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Deny_Click" Margin="0,0,10,0"/>
                    <Button Content="Approve" Style="{StaticResource PrimaryButton}" Padding="28,9" Click="Approve_Click"/>
                </StackPanel>
                <TextBlock x:Name="HintText" Text="" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
