<Window x:Class="Pec.Qc.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Icon="app.ico" Width="720" Height="780" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,20">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="13" Background="{StaticResource AccentSoft}" Margin="0,0,16,0">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" Style="{StaticResource H2}" FontSize="19"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Where the assistant reads and shares its knowledge. Folders can be local or on the server."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,16">
                <Border Style="{StaticResource Card}" Margin="0,0,0,18" Background="{StaticResource AccentSoft}" BorderBrush="#C9D6FF">
                    <StackPanel>
                        <TextBlock Text="Shared office folder" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" Text="One folder for everyone. Skills, learning, requirements, projects, models, reports, users, custom tools and updates all live inside it. Leave empty to keep everything on this PC."/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="BrowseShared_Click"/><TextBox x:Name="SharedBox" Style="{StaticResource Field}"/></DockPanel>
                        <TextBlock Text="Update source  (folder or web address with latest.json, PecQcSetup.exe and payload.zip)" Margin="0,12,0,4"/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="BrowseUpdate_Click"/><TextBox x:Name="UpdateBox" Style="{StaticResource Field}"/></DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="About you" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" Text="Your prompts and what the assistant did are written to the shared activity log with this name and employee code, so the team can support you and learn from every task. You are also listed in the shared user registry."/>
                        <TextBlock Text="Your name" Margin="0,0,0,4"/>
                        <TextBox x:Name="UserNameBox" Style="{StaticResource Field}" Margin="0,0,0,10"/>
                        <TextBlock Text="Employee code" Margin="0,0,0,4"/>
                        <TextBox x:Name="EmployeeBox" Style="{StaticResource Field}" Margin="0,0,0,10"/>
                        <TextBlock Text="Company" Margin="0,0,0,4"/>
                        <TextBox x:Name="CompanyBox" Style="{StaticResource Field}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="RoleText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Autonomy and confirmations" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" Text="How much the assistant may do on its own. QC is read-only: it never changes a model, drawing or client document. At Full it can also read and write files, search the web and run commands on this PC, so it can build a missing helper, test it and keep it for everyone. Saving anything shared (skills, lessons, requirement packs, tools) asks for your approval."/>
                        <TextBlock Text="Autonomy" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AutonomyBox" Padding="8,6" Margin="0,0,0,12"/>
                        <TextBlock Text="Confirmations before it saves something shared" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ApprovalBox" Padding="8,6" Margin="0,0,0,12"/>
                        <CheckBox x:Name="AutoUpdateCheck" Content="Install new versions automatically when the assistant starts (skills, tools and lessons from the shared folder always sync by themselves)"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Navisworks" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" Text="Isometric and GA checks read the 3D model through your own Navisworks Manage (a background run on a copy; your model is never changed). The assistant works with the licence you have, education or commercial: which one is allowed for company work is your company's responsibility. Leave empty to find it automatically."/>
                        <TextBlock Text="Navisworks Manage folder" Margin="0,0,0,4"/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="BrowseNavis_Click"/><TextBox x:Name="NavisBox" Style="{StaticResource Field}"/></DockPanel>
                        <TextBlock x:Name="NavisStateText" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Expander Header="Advanced: keep a part somewhere other than the shared folder" Margin="0,0,0,10" IsExpanded="False">
                <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Normally these four are just folders inside the shared folder above, and follow it automatically. Change one only if that part must live elsewhere." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Skills  (one folder per skill, each with a SKILL.md)" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="BrowseSkills_Click"/><TextBox x:Name="SkillsBox" Style="{StaticResource Field}"/></DockPanel>
                <TextBlock Text="Learning  (lessons, decisions, context and client rules that are saved)" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="BrowseLearning_Click"/><TextBox x:Name="LearningBox" Style="{StaticResource Field}"/></DockPanel>
                <TextBlock Text="Documents  (client procedures, specifications; PDF, Markdown or text)" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="BrowseDocs_Click"/><TextBox x:Name="DocsBox" Style="{StaticResource Field}"/></DockPanel>
                <TextBlock Text="Master prompt file  (the rules)" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="BrowseMaster_Click"/><TextBox x:Name="MasterBox" Style="{StaticResource Field}"/></DockPanel>
                </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0"/>
                <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Padding="24,9" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
