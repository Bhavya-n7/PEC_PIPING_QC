<Window x:Class="Pec.Qc.Desktop.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A few details" Icon="app.ico" Width="580" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False">
    <StackPanel>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,20">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSoft}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                    <TextBlock Text="The assistant needs these before it can start." Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel x:Name="Fields" Margin="26,18,26,6"/>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,14" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0"/>
                <Button Content="Send" Style="{StaticResource PrimaryButton}" Padding="28,9" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
