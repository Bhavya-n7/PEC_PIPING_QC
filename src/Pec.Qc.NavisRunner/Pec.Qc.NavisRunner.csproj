<Project Sdk="Microsoft.NET.Sdk">

  <!-- Starts a hidden Navisworks on a copy of the model and runs the exporter plugin. See Pec.Qc.NavisExport for how Navisworks is found. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Pec.Qc.NavisRunner</AssemblyName>
    <RootNamespace>PecQc.Runner</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <NavisDir Condition="'$(NavisDir)' == ''">$([System.IO.Directory]::GetDirectories('$(ProgramW6432)\Autodesk', 'Navisworks Manage*')[0])</NavisDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NavisDir)' == '' Or !Exists('$(NavisDir)\Autodesk.Navisworks.Automation.dll')">
    <BuildWithoutNavisworks>true</BuildWithoutNavisworks>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildWithoutNavisworks)' != 'true'">
    <Reference Include="Autodesk.Navisworks.Automation">
      <HintPath>$(NavisDir)\Autodesk.Navisworks.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(BuildWithoutNavisworks)' == 'true'">
    <Compile Remove="**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
